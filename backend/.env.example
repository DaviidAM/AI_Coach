# backend/.env.example — reference values for the backend process.
# The backend reads os.environ directly; export these in your shell or set
# them in Docker Compose / your deployment platform.
# All variables are read at startup. Without a reachable OmniRoute gateway the
# backend still starts and uses the MiniMax/offline fallback chain.

# === LLM GATEWAY ===
# OpenAI-compatible chat completions endpoint.
# Code default: http://localhost:8082/v1
# Docker Compose default: http://host.docker.internal:20128/v1
OMNIROUTE_BASE_URL=https://your-gateway.example.com/v1

# Most self-hosted gateways don't require auth; leave blank if so.
OMNIROUTE_API_KEY=

# Combo or model name used for new sessions.
# Code default: auto/best-chat
# Docker Compose default: demo-combo
OMNIROUTE_DEFAULT_MODEL=auto/best-chat

# Retried once when OmniRoute returns 401/404 for the selected model.
OMNIROUTE_DEFAULT_COMBO_FALLBACK=primary-chain

# Optional fallback provider when OmniRoute is unreachable. Used only when set.
MINIMAX_API_KEY=

# === SERVER ===
# Port the backend listens on.
PORT=8091

# === DEMO LIMITS ===
# Maximum user messages per English session. Use -1 for unlimited.
DEMO_MESSAGE_LIMIT=5

# Maximum candidate answers per interview session. Use -1 for unlimited.
INTERVIEW_MESSAGE_LIMIT=20

# === AUDIO CLEANUP (janitor) ===
# How often (seconds) the audio janitor sweeps. Default 3600 (1h).
AUDIO_CLEANUP_INTERVAL_SECONDS=3600

# Max age (seconds) before an audio file is deleted. Default 3600 (1h).
AUDIO_MAX_AGE_SECONDS=3600
