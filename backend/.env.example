# backend/.env.example — copy to .env and fill in

# === REQUIRED ===
# OpenAI-compatible chat completions endpoint (OmniRoute or similar)
OMNIROUTE_BASE_URL=https://your-gateway.example.com/v1

# === OPTIONAL ===
# Most self-hosted gateways don't require auth; leave blank if so
OMNIROUTE_API_KEY=

# Fallback LLM provider. Not used by default — only if OMNIROUTE_BASE_URL
# is unreachable.
MINIMAX_API_KEY=

# === SERVER ===
# Port the backend listens on (default: 8091)
PORT=8091

# === AUDIO CLEANUP ===
# How often (seconds) the audio janitor sweeps. Default 3600 (1h).
AUDIO_CLEANUP_INTERVAL_SECONDS=3600

# Max age (seconds) before an audio file is deleted. Default 3600 (1h).
AUDIO_MAX_AGE_SECONDS=3600
