# frontend/.env.example — copy to .env.local and fill in real values.
# Next.js inlines NEXT_PUBLIC_* at build time, so a rebuild is required
# after changing these in production.

# Backend base URL the browser hits. Must include scheme and port, with no
# trailing slash. Leave empty for Docker/production so the browser uses
# same-origin relative URLs and the Next.js rewrites forward /api/* to the
# backend service.
#
# Local development outside Docker: http://localhost:8091
# Docker Compose: leave empty.
NEXT_PUBLIC_API_URL=

# Server-side rewrite target used by next.config.js for /api/*,
# /static/audio/* and /audio/*. Docker Compose uses the service name.
# Local development outside Docker: http://localhost:8091
BACKEND_URL=http://localhost:8091
