  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "Next.js 14 with TypeScript and CSS Modules",
        "MediaRecorder captures mic audio in the browser",
        "Audio playback via <audio> tags pointing to /static/audio/"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend",
      "items": [
        "FastAPI serves /api/chat and static files from app/static/audio/",
        "faster-whisper (base, CPU) for STT; edge-tts (en-US-AriaNeural) for TTS",
        "SessionStore is in-process — data is lost when the process restarts"
      ]
    },
    {
      "dot": "orange",
      "title": "LLM routing",
      "items": [
        "LLM calls go through OmniRoute at OMNIROUTE_BASE_URL (http://host.docker.internal:20128/v1)",
        "OmniRoute is an OpenAI-compatible gateway running as a systemd service on the host",
        "Providers: omniroute (default), minimax, openai, anthropic, groq"
      ]
    }
  ]
