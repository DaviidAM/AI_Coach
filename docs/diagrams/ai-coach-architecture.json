  "cards": [
    {
      "dot": "cyan",
      "title": "Browser and frontend",
      "items": [
        "Three routes share one design system; the landing page only links to the coaches",
        "Both coaches render the same chat kernel, so a bubble change lands in both",
        "The browser never learns the backend address: every call is same-origin"
      ]
    },
    {
      "dot": "emerald",
      "title": "FastAPI process",
      "items": [
        "Seven routers expose chat, level, corrections, conversation, settings, health and interview",
        "Sessions, corrections and interview state are process-local dictionaries",
        "Audio files on disk are the only state that survives a restart"
      ]
    },
    {
      "dot": "amber",
      "title": "Fallback chains",
      "items": [
        "LLM: custom combo → primary-chain → MiniMax → offline rule-based coach",
        "TTS: edge-tts → Google Translate TTS → text-only answer",
        "Every fallback keeps the text answer intact and never returns HTTP 500"
      ]
    }
  ]
