    {
      "dot": "emerald",
      "title": "Grounded in the offer",
      "items": [
        "The stage rubric is a prompt built per turn from the role brief",
        "Feedback is evaluated against that rubric, not free-form advice",
        "The interviewer never speaks the coaching notes out loud"
      ]
    },
    {
      "dot": "rose",
      "title": "Normalised output",
      "items": [
        "answer_score is clamped to 1-5 and feedback is capped at three items",
        "Feedback aliases and categories are normalised before storage",
        "If the model returns nothing usable, one polish note is injected"
      ]
    },
    {
      "dot": "amber",
      "title": "Works offline",
      "items": [
        "Brief, question and coaching fall back to deterministic rules",
        "The interview stays usable with no LLM at all",
        "Audio is optional: the text answer always survives"
