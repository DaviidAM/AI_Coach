{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "AI Coach — One Full Text Turn",
    "output": "ai-coach-chat-sequence.html",
    "viewBox": [1080, 620],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "standard",
    "views": [
      {
        "id": "full-turn",
        "label": "Full turn",
        "focus": ["user", "browser", "nextjs", "fastapi", "session", "llm", "tts", "audio_dir"],
        "note": "One complete text turn from user pressing Enter to coach audio playing."
      }
    ]
  },
  "participants": [
    { "id": "user",      "type": "external",  "label": "User",           "sublabel": "presses Enter" },
    { "id": "browser",   "type": "external",  "label": "Browser",        "sublabel": "Next.js UI" },
    { "id": "nextjs",    "type": "frontend",  "label": "Next.js",        "sublabel": "/page.tsx" },
    { "id": "fastapi",   "type": "backend",   "label": "FastAPI",        "sublabel": "/api/chat" },
    { "id": "session",   "type": "database",  "label": "SessionStore",   "sublabel": "in-memory" },
    { "id": "llm",       "type": "backend",   "label": "LLM",            "sublabel": "get_llm_reply()" },
    { "id": "tts",       "type": "backend",   "label": "edge-tts",       "sublabel": "synthesize()" },
    { "id": "audio_dir", "type": "database",  "label": "/static/audio/", "sublabel": "on-disk .mp3" }
  ],
  "segments": [
    { "from": 72,  "to": 165, "label": "User input" },
    { "from": 170, "to": 255, "label": "Frontend → FastAPI" },
    { "from": 260, "to": 355, "label": "Session + LLM" },
    { "from": 360, "to": 450, "label": "TTS + write" },
    { "from": 455, "to": 520, "label": "Response" }
  ],
  "messages": [
    { "id": "user-enter",       "from": "user",    "to": "browser",   "y": 172, "label": "Enter key",                          "variant": "default"  },
    { "id": "browser-send",     "from": "browser", "to": "nextjs",   "y": 196, "label": "sendText(text, session_id)",        "variant": "emphasis" },
    { "id": "nextjs-post",      "from": "nextjs",  "to": "fastapi",   "y": 222, "label": "POST /api/chat",                   "variant": "emphasis" },
    { "id": "fastapi-session",  "from": "fastapi", "to": "session",   "y": 252, "label": "get_level / get_history_for_llm",  "variant": "default"  },
    { "id": "session-resp",     "from": "session", "to": "fastapi",   "y": 280, "label": "level, history",                    "variant": "return"   },
    { "id": "fastapi-llm",      "from": "fastapi", "to": "llm",      "y": 308, "label": "get_llm_reply(level, history)",   "variant": "emphasis" },
    { "id": "llm-resp",         "from": "llm",     "to": "fastapi",   "y": 336, "label": "{reply, corrections}",              "variant": "return"   },
    { "id": "fastapi-append",    "from": "fastapi", "to": "session",  "y": 364, "label": "append_message(user+assistant)",  "variant": "default"  },
    { "id": "fastapi-tts",       "from": "fastapi", "to": "tts",      "y": 393, "label": "synthesize(coach_text)",         "variant": "emphasis" },
    { "id": "tts-write",         "from": "tts",     "to": "audio_dir","y": 418, "label": "write .mp3",                     "variant": "default"  },
    { "id": "tts-resp",          "from": "tts",     "to": "fastapi",  "y": 443, "label": "coach_audio_url",                "variant": "return"   },
    { "id": "fastapi-200",       "from": "fastapi", "to": "nextjs",   "y": 468, "label": "200 coach_text, coach_audio_url", "variant": "return"   },
    { "id": "nextjs-ui",         "from": "nextjs",  "to": "browser",  "y": 490, "label": "update UI",                     "variant": "return"   },
    { "id": "browser-play",      "from": "browser", "to": "user",     "y": 510, "label": "<audio> plays coach reply",      "variant": "return"   }
  ],
  "activations": [
    { "participant": "browser",  "from": 172, "to": 514, "type": "external"  },
    { "participant": "nextjs",   "from": 196, "to": 494, "type": "frontend"  },
    { "participant": "fastapi", "from": 222, "to": 472, "type": "backend"   },
    { "participant": "session", "from": 249, "to": 367, "type": "database"  },
    { "participant": "llm",      "from": 305, "to": 339, "type": "backend"   },
    { "participant": "tts",      "from": 390, "to": 446, "type": "backend"   }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend demo gate",
      "items": [
        "page.tsx enforces MESSAGES_LIMIT=5 client-side before sending",
        "atLimit blocks the send() call — no request reaches FastAPI",
        "User sees 'Demo version message limit reached' in the UI"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend flow",
      "items": [
        "append_message tracked per role; history trimmed to MAX_MESSAGES=10",
        "LLM called with {level, history} → {reply, corrections}",
        "TTS synthesis always performed, even for text-only input"
      ]
    },
    {
      "dot": "orange",
      "title": "Session + LLM",
      "items": [
        "SessionStore is in-process memory — lost on FastAPI restart",
        "LLM calls go through OmniRoute at OMNIROUTE_BASE_URL",
        "Corrections filtered by user CEFR level before storage"
      ]
    }
  ]
}
