  "cards": [
    {
      "dot": "cyan",
      "title": "Two services, one tree",
      "items": [
        "Both images build from the same source tree with separate Dockerfiles",
        "The frontend depends on a healthy backend before it starts",
        "Host ports follow the 18xxx range reserved for this project"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reaching the gateway",
      "items": [
        "OmniRoute runs as a systemd service on the host, not in compose",
        "extra_hosts maps host.docker.internal to the bridge gateway",
        "The backend reads OMNIROUTE_BASE_URL from the environment"
      ]
    },
    {
      "dot": "amber",
      "title": "What survives a restart",
      "items": [
        "Audio files live in named volumes and outlive the containers",
        "Sessions, corrections and interview state are process memory only",
        "Rebuilding the frontend is required to change NEXT_PUBLIC_API_URL"
      ]
    }
  ]
