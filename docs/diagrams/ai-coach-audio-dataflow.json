  "cards": [
    {
      "dot": "emerald",
      "title": "Text is the contract",
      "items": [
        "Every message carries text; audio is an optional companion",
        "A transcription failure stops the turn with a controlled 502",
        "If every TTS engine fails the bubble simply has no player"
      ]
    },
    {
      "dot": "orange",
      "title": "What lives on disk",
      "items": [
        "Original recordings are kept under stt/ so the user can replay them",
        "Generated MP3s are written under audio/ and served by the static mount",
        "The janitor deletes mp3, wav and webm files older than one hour"
      ]
    },
    {
      "dot": "violet",
      "title": "Offline degradation",
      "items": [
        "No model? The rule-based coach still answers with corrections",
        "No Edge TTS? Google Translate TTS produces the file instead",
        "The chat never answers with an HTTP 500 because of audio"
      ]
    }
